# Single source of truth for building libstream_server.so (read by native/build-stream-server.sh
# and by the GitHub Actions workflows). Values reproduce the toolchain of the published
# tv-v1.0.3 APKs: rustc 1.99.0 and NDK r27 are embedded in that libstream_server.so, and
# cargo-ndk 4.1.2 was the version `cargo install cargo-ndk` resolved to at that time.
# Change these only deliberately; bumping them changes the shipped native binary.
RUST_TOOLCHAIN=1.99.0
CARGO_NDK_VERSION=4.1.2
ANDROID_NDK_RELEASE=r27c
ANDROID_NDK_VERSION=27.2.12479018
VCPKG_COMMIT=84bab45d415d22042bd0b9081aea57f362da3f35
ANDROID_PLATFORM=24
STREAM_SERVER_FEATURES=libtorrent
